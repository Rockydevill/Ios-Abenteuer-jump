DirectoryIndex index.html index.php

# BEGIN GBD PRELAUNCH LOCK
# Die Staging-Oberfläche bleibt bis zur späteren kontrollierten Test-/Freigabephase
# für normale Besucher unsichtbar. Nur Maintenance und die bereits abgesicherten
# serverseitigen GBD-Service-Endpunkte bleiben erreichbar.
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Maintenance bleibt erreichbar.
RewriteCond %{REQUEST_URI} !^/staging/chatgpt-maintenance(?:/|$) [NC]
# Interne, bereits authentifizierte/signierte Server-Endpunkte bleiben erreichbar.
RewriteCond %{REQUEST_URI} !^/staging/_gbd_proxy\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/staging/gbd-storage-gateway\.php$ [NC]

# In .htaccess-Kontext war [R=404] auf STRATO nicht zuverlässig.
# Stattdessen wird jede normale Anfrage in einen garantiert nicht vorhandenen
# internen Pfad umgeschrieben und die per-directory Rewrite-Verarbeitung mit END
# vollständig beendet. Apache liefert dadurch einen echten HTTP 404.
RewriteRule ^.*$ __gbd_prelaunch_not_found__ [END]
</IfModule>

# Fallback, falls mod_rewrite aus irgendeinem Grund nicht greift.
<IfModule mod_alias.c>
RedirectMatch 404 ^/staging/(?!chatgpt-maintenance(?:/|$)|_gbd_proxy\.php$|gbd-storage-gateway\.php$).*
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Cache-Control "no-store, max-age=0"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
# END GBD PRELAUNCH LOCK

# BEGIN WordPress
# Diese Regeln bleiben für die spätere kontrollierte Testphase vorbereitet.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /staging/
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /staging/index.php [L]
</IfModule>
# END WordPress
